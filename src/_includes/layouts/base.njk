<!DOCTYPE html>
<html lang="cs" prefix="og: https://ogp.me/ns#">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {% set pageTitle = title | default(site.name) %}
    {% set pageDescription = description | default(site.description) %}
    {% set canonicalUrl = site.url + page.url %}
    <title>{{ pageTitle | escape }}</title>
    <meta name="description" content="{{ pageDescription | escape }}">
    <link rel="canonical" href="{{ canonicalUrl | escape }}">
    <meta property="og:type" content="website">
    <meta property="og:locale" content="cs_CZ">
    <meta property="og:site_name" content="{{ site.name | escape }}">
    <meta property="og:title" content="{{ pageTitle | escape }}">
    <meta property="og:description" content="{{ pageDescription | escape }}">
    <meta property="og:url" content="{{ canonicalUrl | escape }}">
    <meta property="og:image" content="{{ (site.url + site.image.path) | escape }}">
    <meta property="og:image:type" content="{{ site.image.type | escape }}">
    <meta property="og:image:width" content="{{ site.image.width }}">
    <meta property="og:image:height" content="{{ site.image.height }}">
    <meta property="og:image:alt" content="{{ site.image.alt | escape }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ pageTitle | escape }}">
    <meta name="twitter:description" content="{{ pageDescription | escape }}">
    <meta name="twitter:image" content="{{ (site.url + site.image.path) | escape }}">
    <meta name="twitter:image:alt" content="{{ site.image.alt | escape }}">
    {% if layoutStylesheet %}<link rel="stylesheet" href="{{ layoutStylesheet | escape }}">{% endif %}
    {% for stylesheet in stylesheets %}<link rel="stylesheet" href="{{ stylesheet | escape }}">{% endfor %}
    <script>
      window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
    </script>
    <script defer src="/_vercel/insights/script.js"></script>
</head>
<body>
    {% block body %}{{ content | safe }}{% endblock %}
</body>
</html>
