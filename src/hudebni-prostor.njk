<script>
  const contactForm = document.querySelector('.contact');
  const contactStatus = document.querySelector('[data-contact-status]');

  if (contactForm && contactStatus) {
    contactForm.addEventListener('submit', async (event) => {
      event.preventDefault();

      const submitButton = contactForm.querySelector('button[type="submit"]');
      const formData = new FormData(contactForm);
      const payload = Object.fromEntries(formData.entries());

      contactStatus.textContent = 'Odesílám dotaz...';
      contactStatus.className = 'contact__status';
      submitButton.disabled = true;

      try {
        const response = await fetch(contactForm.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        if (!response.ok) {
          throw new Error('Formulář se nepodařilo odeslat.');
        }

        contactForm.reset();
        contactStatus.textContent = 'Děkujeme, dotaz dorazil. Ozveme se ti co nejdřív.';
        contactStatus.classList.add('contact__status--success');
      } catch (error) {
        contactStatus.textContent = 'Omlouváme se, odeslání se nepovedlo. Napiš prosím na jindrichuvdum@jindrichuvdum.cz.';
        contactStatus.classList.add('contact__status--error');
      } finally {
        submitButton.disabled = false;
      }
    });
  }
</script>
