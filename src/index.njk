---
layout: layouts/base.njk
title: Jindřichův dům - Horská chata v Krkonoších
---

<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <link rel="stylesheet" href="/css/cottage.css">
</head>
<body>
    <!-- Navigation -->
    <nav class="nav">
        <div class="nav-content">
            <a class="nav-logo" href="/">{{ content.cottage.hero.title }}</a>
            <div class="nav-links">
                <a href="#o-chate">O chatě</a>
                <a href="#pokoje">Pokoje</a>
                <a href="#vybaveni">Vybavení</a>
                <a href="#cenik">Ceník</a>
                <a href="#kontakt">Kontakt</a>
                <a href="/practical-info" class="nav-link-practical">Praktické info</a>
                <a href="/hudebni-prostor" class="nav-link-music">Hudební prostor</a>
            </div>
            <div class="nav-phone">
                <a href="tel:{{ content.cottage.hero.phone }}">{{ content.cottage.hero.phone }}</a>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero">
        <div class="hero-overlay"></div>
        <div class="hero-content">
            <h1 class="hero-title">{{ content.cottage.hero.title }}</h1>
            <p class="hero-subtitle">{{ content.cottage.hero.subtitle }}</p>
            <p class="hero-location">{{ content.cottage.hero.location }}</p>
            <div class="hero-cta">
                <a href="tel:{{ content.cottage.hero.phone }}" class="btn btn-primary">Zavolejte nám</a>
                <a href="#cenik" class="btn btn-secondary">Zobrazit ceník</a>
            </div>
        </div>
    </section>

    <!-- Basic Info Section -->
    <section id="o-chate" class="section">
        <div class="container-narrow">
            <h2 class="section-title">{{ content.cottage.basicInfo.title }}</h2>
            <p class="section-text">{{ content.cottage.basicInfo.description }}</p>
        </div>
    </section>

    <!-- Gallery Section -->
    <section class="gallery-section">
        <div class="container">
            <h2 class="section-title">Fotogalerie</h2>
            <div class="gallery-grid">
                {% for image in content.cottage.gallery.images %}
                <div class="gallery-item">
                    <img src="{{ image }}" alt="Jindřichův dům fotografie {{ loop.index }}" loading="lazy">
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- Rooms Section -->
    <section id="pokoje" class="section section-alt">
        <div class="container-narrow">
            <h2 class="section-title">{{ content.cottage.rooms.title }}</h2>
            <p class="section-text">{{ content.cottage.rooms.description }}</p>
        </div>
    </section>

    <!-- Facilities Section -->
    <section id="vybaveni" class="section">
        <div class="container-narrow">
            <h2 class="section-title">{{ content.cottage.facilities.title }}</h2>
            <p class="section-text">{{ content.cottage.facilities.description }}</p>
        </div>
    </section>

    <!-- Dining Section -->
    <section class="section section-alt">
        <div class="container-narrow">
            <h2 class="section-title">{{ content.cottage.dining.title }}</h2>
            <p class="section-text">{{ content.cottage.dining.description }}</p>
        </div>
    </section>

    <!-- Pricing Section -->
    <section id="cenik" class="section pricing-section">
        <div class="container">
            <h2 class="section-title">{{ content.cottage.pricing.title }}</h2>
            <p class="section-subtitle">{{ content.cottage.pricing.note }}</p>
            
            <div class="pricing-table">
                <table>
                    <thead>
                        <tr>
                            <th>Období</th>
                            <th>Dospělý</th>
                            <th>Dítě (2-12 let)</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for season in content.cottage.pricing.seasons %}
                        <tr>
                            <td>{{ season.period }}</td>
                            <td>{{ season.adult }}</td>
                            <td>{{ season.child }}{% if season.note %} <br><small>({{ season.note }})</small>{% endif %}</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <div class="important-info">
                <h3>Důležité informace</h3>
                <ul>
                    {% for info in content.cottage.pricing.important %}
                    <li>{{ info }}</li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </section>

    <!-- Contact Section -->
    <section id="kontakt" class="section section-alt contact-section">
        <div class="container-narrow">
            <h2 class="section-title">{{ content.cottage.contact.title }}</h2>
            <p class="section-text">Máte dotazy k pobytu nebo chcete rezervaci? Zavolejte nám – domluvíme se.</p>
            <div class="contact-info">
                <div class="contact-item">
                    <h3>{{ content.cottage.contact.name }}</h3>
                    <p>{{ content.cottage.contact.address }}</p>
                </div>
                <div class="contact-item">
                    <p><strong>Telefon:</strong> <a href="tel:{{ content.cottage.hero.phone }}">{{ content.cottage.contact.phone }}</a></p>
                    <p><strong>Email:</strong> <a href="mailto:{{ content.cottage.hero.email }}">{{ content.cottage.contact.email }}</a></p>
                    <p><strong>Další prezentace:</strong> <a href="https://{{ content.cottage.contact.website }}" target="_blank">{{ content.cottage.contact.website_view }}</a></p>
                </div>
                <div class="contact-item">
                    <p><strong>{{ content.cottage.contact.owner }}</strong></p>
                    <p>{{ content.cottage.contact.ownerAddress }}</p>
                    <p>IČO: {{ content.cottage.contact.ico }}</p>
                    <p>DIČ: {{ content.cottage.contact.dic }}</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <p>&copy; 2024 Jindřichův dům. Všechna práva vyhrazena.</p>
            <p><a href="/ubytovaci-rad/" style="color: inherit;">Ubytovací řád</a></p>
        </div>
    </footer>
</body>
</html>
