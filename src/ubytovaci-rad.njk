---
layout: layouts/base.njk
title: Ubytovací řád | Jindřichův dům
permalink: /ubytovaci-rad/index.html
description: "Ubytovací řád Jindřichova domu v Peci pod Sněžkou. Příjezd, pravidla pobytu, bezpečnost a důležité kontakty na jednom místě."
stylesheets:
  - /css/ubytovaci-rad.css
---
    <a class="skip-link" href="#rad">Přejít na ubytovací řád</a>
    <header class="site-header">
        <nav aria-label="Hlavní navigace" class="page-width">
            <a class="brand" href="/">Jindřichův dům</a>
            <div class="header-links"><a href="/practical-info/">Praktické info</a><a href="/hudebni-prostor/">Hudební prostor</a></div>
        </nav>
    </header>
    <main id="rad" class="page-width">
        <header class="intro">
            <p class="eyebrow">Pravidla pobytu · Pec pod Sněžkou</p>
            <h1>Ubytovací řád</h1>
            <p class="lead">{{ accommodationRules.intro }}</p>
        </header>
        <div class="rules-layout">
            <nav class="contents" aria-label="Obsah ubytovacího řádu">
                <h2>Co potřebujete vědět</h2>
                <ol>{% for section in accommodationRules.sections %}
                    <li><a href="#{{ section.id }}">{{ section.title }}</a></li>
                {% endfor %}</ol>
                <a href="#kontakty">Důležité kontakty</a><br>
                <a href="#skoly-a-skupiny">Příloha pro školy a skupiny</a>
            </nav>
            <div class="rules-text">
                {% for section in accommodationRules.sections %}
                <section id="{{ section.id }}" aria-labelledby="nadpis-{{ section.id }}">
                    <h2 id="nadpis-{{ section.id }}"><span>{{ section.number }}.</span> {{ section.title }}</h2>
                    {% for paragraph in section.paragraphs %}<p>{{ paragraph }}</p>{% endfor %}
                    {% if section.items.length %}<ul>{% for item in section.items %}<li>{{ item }}</li>{% endfor %}</ul>{% endif %}
                </section>
                {% endfor %}
                <section id="kontakty" aria-labelledby="nadpis-kontakty" class="contacts">
                    <h2 id="nadpis-kontakty">Důležité kontakty</h2>
                    <dl>
                        <div><dt>Provozovatel</dt><dd><a href="tel:+420739655826">+420 739 655 826</a></dd></div>
                        <div><dt>Tísňová linka</dt><dd><a href="tel:112">112</a></dd></div>
                        <div><dt>Záchranná služba</dt><dd><a href="tel:155">155</a></dd></div>
                        <div><dt>Hasiči</dt><dd><a href="tel:150">150</a></dd></div>
                        <div><dt>Horská služba</dt><dd><a href="tel:1210">1210</a></dd></div>
                    </dl>
                    <p><a href="mailto:jindrichuvdum@jindrichuvdum.cz">jindrichuvdum@jindrichuvdum.cz</a></p>
                </section>
                <p class="closing">{{ accommodationRules.closing }}</p>
                <section id="skoly-a-skupiny" aria-labelledby="nadpis-skoly">
                    <p class="eyebrow">Příloha k ubytovacímu řádu</p>
                    <h2 id="nadpis-skoly">Školy a organizované skupiny</h2>
                    <p>{{ groupRules.intro }}</p>
                    {% for section in groupRules.sections %}
                    <h3>{{ section.title }}</h3>
                    <ul>{% for item in section.items %}<li>{{ item }}</li>{% endfor %}</ul>
                    {% endfor %}
                    <p>{{ groupRules.closing }}</p>
                </section>
            </div>
        </div>
    </main>
    <footer class="page-width"><p>Moruška s.r.o. · Jindřichův dům</p><a href="/">Zpět na hlavní stránku</a></footer>
